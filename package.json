{
  "name": "bucx-api",
  "version": "1.0.0",
  "description": "BUX API - Borderless Banking Experience",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:mock": "node scripts/dev-mode.js && npm run dev",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "migrate": "ts-node src/db/run-migrations.ts",
    "check-env": "node scripts/check-env.js",
    "init-db": "node scripts/init-mongodb.js"
  },
  "resolutions": {
    "@solana/spl-token": "0.4.13"
  },
  "engines": {
    "node": "18.x"
  },
  "keywords": [
    "banking",
    "api",
    "solana",
    "bridge",
    "supabase"
  ],
  "author": "BUCX Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "bip39": "^3.1.0",
    "bullmq": "^5.72.1",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "cryptex-js": "^1.0.6",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.4",
    "from": "^0.1.7",
    "google-auth-library": "^9.2.0",
    "helmet": "^7.1.0",
    "import": "^0.0.6",
    "ioredis": "^5.10.1",
    "jsbi": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.6",
    "mongoose": "^8.13.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.7",
    "openapi-to-postmanv2": "^5.0.0",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rpc-websockets": "^10.0.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xss": "^1.0.15",
    "yup": "^1.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.14",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
